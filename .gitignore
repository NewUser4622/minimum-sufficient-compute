# generated at run time, never source
__pycache__/
*.pyc
.ipynb_checkpoints/

# storage roots -- resolve_storage() probes and fills these; they are DATA
msc_data/
msc_results/
.msc_write_probe

# the library is EMBEDDED in each notebook and written out at run time.
# a copy sitting next to the notebooks is a build artifact, not source.
# One rule for every generator, so a new notebooks_* folder is covered the day
# it is created rather than the day someone notices the artifact in `git status`.
notebooks*/msc_lib.py
notebooks*/msc_core.py

# scratch
scratch/
Z:/
*.tmp
